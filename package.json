{
  "name": "ims",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @ims/api dev\" \"pnpm --filter @ims/web dev\"",
    "build": "pnpm --filter @ims/shared build && pnpm --filter @ims/api build && pnpm --filter @ims/web build",
    "test": "pnpm -r --sequential test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --sequential typecheck",
    "db:migrate": "pnpm --filter @ims/api db:migrate",
    "db:rollback": "pnpm --filter @ims/api db:rollback",
    "db:make": "pnpm --filter @ims/api db:make",
    "db:seed": "pnpm --filter @ims/api db:seed",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml stop"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "concurrently": "9.1.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1"
  }
}
