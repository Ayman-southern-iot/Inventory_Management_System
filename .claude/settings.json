{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npm run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(docker compose *)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(docker compose down -v*)",
      "Bash(docker system prune*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Read(./.env)",
      "Read(./infra/.env)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-state.sh\"",
            "timeout": 10,
            "statusMessage": "Loading project state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-hardcoding.sh"
          }
        ]
      }
    ]
  }
}
