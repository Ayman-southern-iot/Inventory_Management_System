# Local development environment.
#   cp .env.example .env
# Generate the two secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit .env. The API refuses to boot on a placeholder secret.

NODE_ENV=development

# --- API ---------------------------------------------------------------------
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
# Vite dev server origin. Empty in production — the SPA is same-origin behind Caddy.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
# Port 5433 avoids the other Postgres containers that may already be on this machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=ims
POSTGRES_USER=ims
POSTGRES_PASSWORD=ims_local_dev_password
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10

# --- Auth --------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_48_RANDOM_BYTES_base64url_at_least_32_chars
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_48_RANDOM_BYTES_at_least_32_chars
# A leaked download URL must not verify as a session token — keep this third key distinct
# from the two above. Same shape as the JWT secrets.
PDF_SIGNING_SECRET=REPLACE_WITH_A_DIFFERENT_48_RANDOM_BYTES_distinct_from_jwt
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Login backoff (exponential, capped) --------------------------------------
# The window after N prior failures is min(2^N × LOGIN_THROTTLE_BASE_WINDOW_SECONDS,
# LOGIN_THROTTLE_MAX_WINDOW_SECONDS). 1 failure => 60s, 2 => 120s, 3 => 240s, … capped at
# the max. Counts reset when a successful login lands.
LOGIN_THROTTLE_BASE_WINDOW_SECONDS=30
LOGIN_THROTTLE_MAX_WINDOW_SECONDS=900

# --- Throttler tiers (named) -------------------------------------------------
# Requests are counted per source IP. The 'auth' tier applies to credential-bearing routes
# (login, refresh, logout, change-password, /me/signature/content); the 'public' tier to
# reachable-without-session routes (health, BOM PDF download); the 'authenticated' tier to
# everything else. Login additionally has a 'loginBurst' ceiling layered on top.
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_PUBLIC_LIMIT=60
THROTTLE_PUBLIC_TTL_SECONDS=60
THROTTLE_AUTHENTICATED_LIMIT=300
THROTTLE_AUTHENTICATED_TTL_SECONDS=60
LOGIN_BURST_LIMIT=10
LOGIN_BURST_TTL_SECONDS=60

# --- Request body caps -------------------------------------------------------
# The two parsers are installed in main.ts. Limits are enforced before any controller runs,
# so an oversized body fails with 413 long before multer has a chance to buffer it.
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb

# --- app_settings first-boot seeds -------------------------------------------
# These seed the app_settings table on a fresh install ONLY. After that the admin
# panel owns the values and changing these has no effect.
SETTING_EXPENSE_THRESHOLD_BDT=15000
SETTING_APPROVER_SLOTS_BELOW_THRESHOLD=1
SETTING_APPROVER_SLOTS_AT_OR_ABOVE_THRESHOLD=2
# Phase 05: a single admin-designated approver for sub-threshold requisitions. Empty
# means "not configured" — submitting a sub-threshold requisition then refuses with 409
# until the admin sets it via /admin/settings.
SETTING_SUBTHRESHOLD_APPROVER_USER_ID=

# Phase 06: which actions the audit log records. Empty means "all of them", which is what a
# fresh install wants. Comma-separated action names otherwise. Security-relevant actions
# (logins, user and settings changes, the purge itself) are always recorded regardless.
SETTING_AUDIT_ENABLED_ACTIONS=
# Days of audit history to keep. 0 = keep forever, and is the default: audit history is only
# ever deleted because an admin deliberately configured it. Non-zero values must be one of the
# explicit presets (5, 10, 15, 30, 90, 180, 365, 1095, 1825, 3650 days).
SETTING_AUDIT_RETENTION_DAYS=0

# --- PDF rendering (OQ-11) ---------------------------------------------------
# Letterhead logo inlined at the top of every BOM PDF. Path is resolved relative to
# the API process working directory. Blank renders a placeholder.
PDF_LETTERHEAD_PATH=./apps/web/public/southern-iot-logo.png

# Monitoring floor (Phase 06). Thresholds, not literals.
MONITOR_DISK_WARN_PERCENT=80
# Nightly backup at 02:00 plus slack. Older than this means the job stopped and nobody noticed.
MONITOR_BACKUP_MAX_AGE_HOURS=26
# Where infra/backup.sh writes. Leave blank on a dev machine that takes no backups.
MONITOR_BACKUP_DIR=

# Report date ranges are resolved in this zone, not UTC.
REPORTING_TIME_ZONE=Asia/Dhaka

# Company identity printed on every BOM. Address lines are pipe-separated.
COMPANY_NAME=Southern IoT
COMPANY_ADDRESS=House 26, Road 13, Sector 14|Uttara, Dhaka - 1230|Bangladesh
# Resolved relative to the API's working directory. Despite the source file's name this asset is
# a JPEG; the renderer identifies it by magic bytes, so the extension here is only a label.
COMPANY_LOGO_PATH=./assets/letterhead/siot-logo.jpg
PDF_PAGE_FORMAT=A4
PDF_MARGIN_TOP_MM=45
PDF_MARGIN_RIGHT_MM=15
PDF_MARGIN_BOTTOM_MM=30
PDF_MARGIN_LEFT_MM=15
PDF_RENDER_TIMEOUT_MS=30000
PDF_SIGNED_URL_TTL_SECONDS=300

# --- Seed admin --------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@ims.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin1
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_DESIGNATION=System Administrator

# --- Web (Vite) --------------------------------------------------------------
WEB_PORT=5173
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
