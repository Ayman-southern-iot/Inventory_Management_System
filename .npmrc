# Nest's DI and the Kysely/pg pairing both misbehave under strict isolation when a
# transitive peer is hoisted differently per package. One shared hoist pattern keeps
# `reflect-metadata` a singleton across the workspace.
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
public-hoist-pattern[]=*reflect-metadata*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
