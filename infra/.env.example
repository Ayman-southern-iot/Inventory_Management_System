# ---- copy to .env on the VM and fill in. .env is gitignored, never committed ----
# chmod 600 .env — it holds the database password and both JWT secrets.
#
# Every variable below is validated by apps/api/src/config/config.schema.ts at boot.
# A missing or malformed one crashes the API naming the variable, rather than starting
# in a half-configured state. Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---- images ----
# Where images are pulled from (e.g. GitHub Container Registry).
# Leave as `local` to build from source with `docker compose up -d --build`.
REGISTRY=ghcr.io/your-org
# Pin an explicit tag so rollback is one edit + one deploy. Avoid `latest`.
IMS_TAG=v1.0.0

# Public hostname. Caddy issues TLS automatically for a real hostname;
# for LAN-only, put a bare `:80` in the Caddyfile instead.
IMS_DOMAIN=ims.yourcompany.com

# ---- app ----
NODE_ENV=production
TZ=Asia/Dhaka
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
# Empty in production — the SPA is served same-origin behind Caddy, so no CORS is needed.
CORS_ALLOWED_ORIGINS=

# ---- database ----
# `db` is the compose service name. Postgres is never published to the host.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ims
POSTGRES_USER=ims
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10

# ---- auth ----
# Minimum 32 characters each, and they must differ from each other.
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_a_DIFFERENT_openssl_rand_hex_32
# Signs BOM download URLs. REQUIRED — the API refuses to boot without it. Must be a third
# distinct value: a leaked download link must not verify as a session token.
PDF_SIGNING_SECRET=CHANGE_ME_a_THIRD_DIFFERENT_openssl_rand_hex_32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ---- first administrator ----
# Created by `pnpm db:seed`. In production the account is created with
# must_change_password set, so this password is only used once.
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=CHANGE_ME_at_least_12_characters
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_DESIGNATION=System Administrator

# ---- business defaults ----
# These SEED app_settings on a fresh install only. Once seeded, the admin panel owns
# the values and editing this file has no effect — that is what makes the threshold
# changeable without a redeploy (requirements §11).
SETTING_EXPENSE_THRESHOLD_BDT=15000
SETTING_APPROVER_SLOTS_BELOW_THRESHOLD=1
SETTING_APPROVER_SLOTS_AT_OR_ABOVE_THRESHOLD=2

# The over-budget tolerance a BOM may exceed its approved total by, before it bounces
# back for re-approval (OQ-05).
SETTING_BOM_OVER_BUDGET_TOLERANCE_PCT=10
# A single admin-designated approver for requisitions BELOW the threshold. Blank means
# "not configured", and sub-threshold requisitions then refuse to submit until an admin
# sets it in Admin → Settings. The Approver 1/2 slots do not apply below the threshold.
SETTING_SUBTHRESHOLD_APPROVER_USER_ID=
# Which actions the audit log records. Blank = all of them, which is what you want.
# Security-relevant actions are always recorded regardless of this setting.
SETTING_AUDIT_ENABLED_ACTIONS=
# Days of audit history to keep. 0 = forever, and is the default. Non-zero values must be one
# of the explicit presets (5, 10, 15, 30, 90, 180, 365, 1095, 1825, 3650 days).
SETTING_AUDIT_RETENTION_DAYS=0

# ---- company identity on the BOM letterhead ----
COMPANY_NAME=Southern IoT
# Pipe-separated address lines.
COMPANY_ADDRESS=House 26, Road 13, Sector 14|Uttara, Dhaka - 1230|Bangladesh
# Resolved relative to /app inside the container. Baked into the image.
COMPANY_LOGO_PATH=./assets/letterhead/siot-logo.jpg

# ---- storage ----
# Both sit under /app/storage, which is the `files` volume. Anything written outside that
# volume is lost the next time the container is recreated.
FILE_STORAGE_DIR=./storage/files
PDF_STORAGE_DIR=./storage/pdf
UPLOAD_MAX_IMAGE_BYTES=2000000
UPLOAD_MAX_DOCUMENT_BYTES=10000000

# ---- PDF rendering ----
PDF_PAGE_FORMAT=A4
PDF_MARGIN_TOP_MM=45
PDF_MARGIN_RIGHT_MM=15
PDF_MARGIN_BOTTOM_MM=30
PDF_MARGIN_LEFT_MM=15
PDF_RENDER_TIMEOUT_MS=30000
# How long a BOM download link stays valid. Short on purpose — it is a bearer capability.
PDF_SIGNED_URL_TTL_SECONDS=300

# ---- reporting ----
# Expense report date ranges are resolved in this zone, not UTC. At 4am Dhaka the UTC date
# is still yesterday, so "today" would find nothing.
REPORTING_TIME_ZONE=Asia/Dhaka

# ---- monitoring ----
# Checked hourly. Admins are notified in-app on the transition into failure (OQ-10: no SMTP).
MONITOR_DISK_WARN_PERCENT=80
# Nightly backup at 02:00 plus slack. Older than this means the cron job stopped.
MONITOR_BACKUP_MAX_AGE_HOURS=26
# Where backup.sh writes, as the API container sees it. docker-compose.yml mounts the host's
# ./backups here read-only. Blank disables the check entirely — do not blank it in production.
MONITOR_BACKUP_DIR=/backups

# ---- not implemented ----
# Email is out of scope for v1 (OQ-10: no SMTP relay, in-app notifications only).
# It will appear here as a real variable when the code that reads it exists —
# an env var with no reader is a lie about what the system does.
